# Archive Search - Cloudflare Worker
# Semantic search across conversation archives via MCP

name = "archive-search"
main = "src/index.js"
compatibility_date = "2024-01-01"
compatibility_flags = ["nodejs_compat"]

# API_KEY is stored as a Cloudflare secret — never commit it to your repo.
# After first deploy, run: echo "your-key" | wrangler secret put API_KEY
# Generate a key with: openssl rand -hex 16

[[d1_databases]]
binding = "DB"
database_name = "archive-search"
# Get this from: wrangler d1 create archive-search
database_id = "your-database-id-here"

[[vectorize]]
binding = "VECTORS"
# Create with: wrangler vectorize create archive-search-vectors --dimensions=768 --metric=cosine
index_name = "archive-search-vectors"

[ai]
binding = "AI"
